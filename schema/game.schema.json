{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaaburgh/shadps4-readbacks-db/blob/main/schema/game.schema.json",
  "title": "shadPS4 readbacks game record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "serial",
    "title",
    "last_reviewed",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "serial": {
      "type": "string",
      "pattern": "^CUSA[0-9]{5}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "mode",
          "finding",
          "confidence",
          "shadps4_version",
          "game_version",
          "comparison",
          "co_requirements",
          "summary",
          "evidence"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "mode": {
            "enum": [
              "disabled",
              "relaxed",
              "precise"
            ]
          },
          "finding": {
            "enum": [
              "required",
              "sufficient",
              "beneficial",
              "no_benefit"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "shadps4_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "game_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "comparison": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "disabled": {
                "enum": [
                  "fails",
                  "incorrect",
                  "partial",
                  "works",
                  "improves",
                  "no_change",
                  "not_tested",
                  "not_reported"
                ]
              },
              "relaxed": {
                "enum": [
                  "fails",
                  "incorrect",
                  "partial",
                  "works",
                  "improves",
                  "no_change",
                  "not_tested",
                  "not_reported"
                ]
              },
              "precise": {
                "enum": [
                  "fails",
                  "incorrect",
                  "partial",
                  "works",
                  "improves",
                  "no_change",
                  "not_tested",
                  "not_reported"
                ]
              }
            },
            "minProperties": 1
          },
          "co_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "os": {
                "type": "string"
              },
              "cpu": {
                "type": "string"
              },
              "gpu": {
                "type": "string"
              }
            },
            "minProperties": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url",
                "note"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "compatibility_issue",
                    "compatibility_issue_comment",
                    "upstream_issue",
                    "upstream_pr",
                    "other"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
